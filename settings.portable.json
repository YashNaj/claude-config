{
  "model": "fable",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "switchModelsOnFlag": false,
  "autoMode": {
    "soft_deny": [
      "$defaults"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/exercise-mode.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/typecheck-on-edit.sh\"",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/green-gate.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
